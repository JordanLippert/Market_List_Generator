{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "removeComments": false,
    "outDir": "Presentation/WebApp/wwwroot/js",
    "rootDir": "Presentation/WebApp/wwwroot/ts",
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": [
    "Presentation/WebApp/wwwroot/ts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "bin",
    "obj"
  ]
}
